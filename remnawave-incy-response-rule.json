{
  "name": "INCY (all platforms)",
  "description": "INCY any OS: XRAY_JSON без Hetzner + geo routing",
  "enabled": true,
  "operator": "AND",
  "conditions": [
    {
      "headerName": "user-agent",
      "operator": "REGEX",
      "value": "^INCY/",
      "caseSensitive": false
    }
  ],
  "responseType": "XRAY_JSON",
  "responseModifications": {
    "headers": [
      {
        "key": "routing",
        "value": "incy:"
      }
    ],
    "subscriptionTemplate": "Happ",
    "excludeHostsByTags": [
      "HETZNER",
      "V2JOHNY72416"
    ]
  }
}
